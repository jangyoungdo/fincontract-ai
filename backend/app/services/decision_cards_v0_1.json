      "rule_id": "R04_UNILATERAL_CHANGE",
      "polarity": "safe_exception",
      "title": "사전 통지와 종료권이 보장된 장래 변경",
      "source_class": "synthetic_development_pattern",
      "review_status": "synthetic_verified",
      "evaluation_split": "development",
      "factor_groups": [
