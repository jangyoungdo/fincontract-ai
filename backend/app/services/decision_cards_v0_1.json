      "rule_id": "R04_UNILATERAL_CHANGE",
      "polarity": "risk_pattern",
      "title": "고객 선택권 없는 중요 조건 변경",
      "source_class": "synthetic_development_pattern",
      "review_status": "synthetic_verified",
      "evaluation_split": "development",
      "factor_groups": [
        {"code": "business_controls_change", "patterns": ["은행|회사|사업자|채권자|금융사", "일방|임의|내부.*판단"]},
        {"code": "important_term_changes", "patterns": ["조건|금리|수수료|한도|상환|서비스", "변경|조정|상향|재설계"]},
        {"code": "choice_absent", "patterns": ["동의 없이|승낙 없이|거절.*수 없|종료.*수 없|선택권.*없"]}
      ],
      "text": "사업자가 고객의 동의나 실질적인 거절 선택권 없이 금리, 수수료 또는 계약의 중요 조건을 변경하는 구조는 일방적 변경 위험을 검토해야 한다."
    },
    {
