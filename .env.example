# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database and retrieval
DATABASE_URL=postgresql+psycopg://fincontract:change-me@postgres:5432/fincontract
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Claude API: leave blank in fake-provider mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_PROVIDER=fake

# Upload and retention policy
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
MAX_UPLOAD_BYTES=10485760
DOCUMENT_TTL_HOURS=24

# Optional queue
USE_ASYNC_WORKER=false
REDIS_URL=redis://redis:6379/0

