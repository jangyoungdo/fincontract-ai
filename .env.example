# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database and retrieval
DATABASE_URL=postgresql+psycopg://fincontract:change-me@postgres:5432/fincontract
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8001
CHROMA_PATH=/data/chroma
# local_hashing is dependency-free; chroma_default runs local all-MiniLM-L6-v2.
# Use a fresh CHROMA_PATH when changing provider because dimensions differ.
EMBEDDING_PROVIDER=local_hashing

# Claude API: leave blank in fake-provider mode
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_BALANCED_MODEL=
ANTHROPIC_DEEP_MODEL=
LLM_PROVIDER=fake
ALLOW_EXTERNAL_LLM=false

# Upload and retention policy
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
MAX_UPLOAD_BYTES=10485760
DOCUMENT_TTL_HOURS=24
DOCUMENT_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ADMIN_AUDIT_TOKEN=replace-with-a-long-random-admin-token
AUDIT_RETENTION_DAYS=365
RETENTION_INTERVAL_SECONDS=300

# Optional queue
USE_REDIS=false
REDIS_URL=redis://redis:6379/0
