# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
FINCONTRACT_SITE_ADDRESS=http://127.0.0.1
# Server-only Next.js proxy target. Compose overrides this with http://backend:8000.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Database and retrieval
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://fincontract:change-me@postgres:5432/fincontract
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8001
CHROMA_PATH=/data/chroma
# local_hashing is dependency-free; chroma_default runs local all-MiniLM-L6-v2.
# Use a fresh CHROMA_PATH when changing provider because dimensions differ.
EMBEDDING_PROVIDER=local_hashing

# Claude API: leave blank in fake-provider mode
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_BALANCED_MODEL=
ANTHROPIC_DEEP_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=20
# Keep SDK retries at zero; Redis worker attempts are the single retry budget.
ANTHROPIC_SDK_MAX_RETRIES=0
LLM_MAX_CALLS_PER_ANALYSIS=8
LLM_PROVIDER=fake
ALLOW_EXTERNAL_LLM=false

# OpenAI Responses API experiment. API billing is separate from ChatGPT/Codex plans.
# Only masked rule signals and retrieved evidence are sent; response storage is disabled.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_BALANCED_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=30
OPENAI_CONTEXT_REVIEW_ENABLED=false
OPENAI_CONTEXT_MAX_CALLS=2
OPENAI_CONTEXT_MAX_CHARS_PER_CALL=12000
OPENAI_CONTEXT_MAX_CANDIDATES_PER_SECTION=3
OPENAI_SUMMARY_ENABLED=true

# Private decision-card RAG. Scores and cards are never returned by the public API.
DECISION_RAG_ENABLED=true
DECISION_RAG_MIN_SCORE=0.70
DECISION_RAG_MARGIN=0.08

# Upload and retention policy
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=50
OCR_ENABLED=false
OCR_LANGUAGES=kor+eng
OCR_DPI=200
OCR_MAX_PIXELS_PER_PAGE=8000000
OCR_TIMEOUT_SECONDS=15
OCR_MIN_CHARACTERS_PER_PAGE=10
OCR_MIN_ALNUM_RATIO=0.25
DOCUMENT_TTL_HOURS=24
DOCUMENT_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ADMIN_AUDIT_TOKEN=replace-with-a-long-random-admin-token
AUDIT_RETENTION_DAYS=365
RETENTION_INTERVAL_SECONDS=300

# Optional queue
USE_REDIS=false
REDIS_URL=redis://redis:6379/0
